<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8611616"
    android:backgroundTint="#9B56F0"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="156dp"
        android:layout_height="72dp"
        android:background="#C5ACEB"
        android:gravity="center"
        android:text="Это ваши кубики"
        android:textColor="#0F0E0E"
        android:textColorHighlight="#662DEB"
        android:textColorHint="#662DEB"
        android:textColorLink="#662DEB"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.073" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.41">


        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:justifyContent="center">

            <ImageButton
                android:id="@+id/D6"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/d6"
                android:src="@drawable/d6"
                android:text="@string/d6"
                android:textAlignment="viewStart"
                android:textDirection="locale" />

            <ImageButton
                android:id="@+id/D4"
                style="@android:style/Widget.ImageButton"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:backgroundTint="#008E4747"
                android:contentDescription="@string/d4"
                android:src="@drawable/d4"
                android:textAlignment="textEnd"
                android:textDirection="anyRtl" />

            <ImageButton
                android:id="@+id/D8"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/d8"
                android:src="@drawable/d8" />
            <ImageButton
                android:id="@+id/D10"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/d10"
                android:src="@drawable/d10" />

            <ImageButton
                android:id="@+id/D12"
                style="@android:style/Widget.ImageButton"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:backgroundTint="#008E4747"
                android:contentDescription="@string/d12"
                android:src="@drawable/d12" />

            <ImageButton
                android:id="@+id/D20"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/d12"
                android:src="@drawable/d20" />

        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="150dp"
        android:layout_marginTop="520dp"
        android:layout_marginEnd="140dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <CheckBox
            android:id="@+id/Adv"
            android:layout_width="172dp"
            android:layout_height="58dp"
            android:text="Преимущество"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="76dp"
            tools:layout_editor_absoluteY="520dp" />

        <CheckBox
            android:id="@+id/Disadv"
            android:layout_width="112dp"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="Помеха"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="76dp"
            tools:layout_editor_absoluteY="520dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/diceControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"

        app:layout_constraintTop_toBottomOf="@id/linearCheck"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/Plus1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/plus"
            android:textColor="#0F0E0E"
            android:backgroundTint="#C5ACEB"/>

        <TextView
            android:id="@+id/cntofdice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center"
            android:text="Количество кубиков" />

        <Button
            android:id="@+id/Minus1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/minus"
            android:textColor="#0F0E0E"
            android:backgroundTint="#C5ACEB"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"

        app:layout_constraintTop_toBottomOf="@id/diceControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/Plus2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/plus"
            android:textColor="#0F0E0E"
            android:backgroundTint="#C5ACEB" />

        <TextView
            android:id="@+id/moreres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center"
            android:text="Плюс к значению" />

        <Button
            android:id="@+id/Minus2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/minus"
            android:textColor="#0F0E0E"
            android:backgroundTint="#C5ACEB" />

    </LinearLayout>

    <Button
        android:id="@+id/Custom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#C5ACEB"
        android:text="Собственный куб"
        android:textColor="#0F0E0E"
        android:textColorLink="#C5ACEB"
        app:iconTint="#C5ACEB"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#C5ACEB"
        android:onClick="openSecondActivity"
        android:text="История бросков"
        android:textColor="#0F0E0E"
        app:layout_constraintStart_toEndOf="@id/Custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>